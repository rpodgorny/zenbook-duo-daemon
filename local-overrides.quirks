# ASUS Zenbook Duo - libinput quirk for palm rejection (disable-while-typing).
#
# Install by merging into /etc/libinput/local-overrides.quirks. That file may already
# hold unrelated stanzas of your own, so merge rather than overwrite.
#
# Detached, the keyboard and the touchpad both enumerate as external Bluetooth devices.
# libinput will not pair an external touchpad with a keyboard for DWT until the combo
# layout says the touchpad sits below a keyboard, so DWT stays unavailable for as long
# as the keyboard is off the dock.
#
# Note this is the touchpad attribute, not AttrKeyboardIntegration=internal on the
# keyboard. The keyboard one is what the ROG entries in libinput's own
# 50-system-asus.quirks use, but it does nothing here: on those machines the touchpad is
# internal and the keyboard has a different vid/pid, whereas on the Duo both halves are
# external and share one vid/pid, so marking the touchpad as a combo is enough on its
# own. Measured by isolating each stanza with LIBINPUT_QUIRKS_DIR and reading
# `Disable-w-typing` out of `libinput list-devices`:
#
#   stock only ......................................... n/a
#   AttrKeyboardIntegration=internal on the keyboard .... n/a
#   AttrTPKComboLayout=below on the touchpad ........... enabled
#
# Bluetooth product ids differ per model, and are the docked id plus one:
#
#              docked   bluetooth
#   UX8406MA   0x1B2C   0x1B2D     (2024)
#   UX8406CA   0x1BF2   0x1BF3     (2025)
#
# Check what your machine reports before trusting these:
#
#   libinput list-devices | grep -A8 Touchpad
#   libinput quirks list /dev/input/eventNN
#
# and to try a change without installing it, copy /usr/share/libinput/*.quirks plus this
# file into a scratch directory and point libinput at it:
#
#   libinput quirks validate --data-dir DIR
#   LIBINPUT_QUIRKS_DIR=DIR libinput list-devices
#
# Quirks are read when a device is added, so a change only takes effect once the
# keyboard reconnects or the session restarts. Your compositor also has to enable DWT:
# niri needs `dwt` in its `input { touchpad { ... } }` block, and omitting it means off.
#
# The 2025 stanza is verified on hardware. The 2024 ids come from the report in upstream
# issue #8 and are untested here.
#
# Docked over the pogo pins is deliberately not covered: it was never established
# whether DWT needs a quirk in that mode.

[ASUS Zenbook Duo Bluetooth Touchpad Combo 2024]
MatchUdevType=touchpad
MatchBus=bluetooth
MatchVendor=0x0B05
MatchProduct=0x1B2D
AttrTPKComboLayout=below

[ASUS Zenbook Duo Bluetooth Touchpad Combo 2025]
MatchUdevType=touchpad
MatchBus=bluetooth
MatchVendor=0x0B05
MatchProduct=0x1BF3
AttrTPKComboLayout=below
